#!/usr/bin/env python3
from __future__ import annotations

import argparse
import dataclasses
import json
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

EXCLUDED_SUBSTRINGS = (
    ".app/Contents/",
    "/acp-agents/",
    "/Library/Application Support/",
    "typingsInstaller.js",
    "tsserver.js",
    "eslintServer.js",
    "js-language-service.js",
    "tailwindcss-language-server",
)

EXCLUDED_BINARIES = {
    "agy",
    "agy_acp_server",
    "agy_acp_server.py",
    "beam.smp",
    "cef_server",
    "claude",
    "clion",
    "code",
    "codex",
    "com.docker.backend",
    "cursor",
    "datagrip",
    "dlv",
    "docker",
    "finder",
    "goland",
    "golangci-lint",
    "gopls",
    "idea",
    "java",
    "jetbrains-toolbox",
    "junie",
    "localharness_external",
    "mysqld",
    "phpstorm",
    "pi",
    "postgres",
    "pycharm",
    "redis-server",
    "rider",
    "rubymine",
    "spotify",
    "webstorm",
    "windowserver",
}

FRONTEND_CMD_RE = re.compile(
    r"(?:"
    r"(?:^|[\s/])react-router(?:-serve)?(?:\s|$)"
    r"|@react-router/dev"
    r"|(?:^|[\s/])vite(?:\.js)?(?:\s|$)"
    r"|(?:^|[\s/])next(?:-server)?(?:\s+(?:dev|start)\b|$)"
    r"|(?:^|[\s/])remix(?:-serve|\s+(?:vite:dev|dev)\b)"
    r"|(?:^|[\s/])(?:astro|nuxt|nuxi|wrangler|netlify|vercel)\s+(?:dev|preview)\b"
    r"|(?:^|[\s/])webpack(?:-dev-server|\s+serve\b)"
    r"|(?:^|[\s/])turbo\s+(?:run\s+)?dev\b"
    r"|(?:^|[\s/])esbuild(?:\s|$).*(?:--service|--ping|--serve|--watch)"
    r"|(?:^|[\s/])(?:tsx\s+watch|nodemon)\b"
    r")",
    re.IGNORECASE,
)

PACKAGE_DEV_WRAPPER_RE = re.compile(
    r"(?:^|[\s/])(?:npm|pnpm|yarn|bun)\s+(?:run\s+)?(?:dev|start|preview)\b",
    re.IGNORECASE,
)

WT_TETHER_RE = re.compile(r"(?:^|[\s/])wt\s+.*\bstep\s+tether\b")
SHELL_WRAPPER_RE = re.compile(r"^(?:/[^\s]+/)?(?:sh|bash|zsh|dash)\s+-c\s+")
NODE_MODULES_DIR_RE = re.compile(r"(/[^\"'\s]+?)/node_modules/")
DURATION_TOKEN_RE = re.compile(r"(\d+)\s*([smhd])", re.IGNORECASE)


@dataclasses.dataclass
class ListenPort:
    port: int
    host: str
    raw: str

    @property
    def is_ephemeral_loopback(self) -> bool:
        return self.host in ("127.0.0.1", "[::1]", "::1") and self.port >= 10000


@dataclasses.dataclass
class ProcInfo:
    pid: int
    ppid: int
    etime_raw: str
    elapsed_secs: int
    rss_bytes: int
    mem_bytes: int
    command: str
    exe_base: str


@dataclasses.dataclass
class ServerGroup:
    root_pid: int
    pids: list[int]
    kind: str
    scope: str
    project_dir: str
    dir_exists: bool
    ports: list[ListenPort]
    total_mem_bytes: int
    uptime_secs: int
    command_summary: str

    @property
    def is_stale(self) -> bool:
        return self.scope in ("orphan", "temp-air", "worktree")

    @property
    def primary_ports(self) -> list[int]:
        if not self.ports:
            return []
        non_ephemeral = [lp.port for lp in self.ports if not lp.is_ephemeral_loopback]
        ordered = non_ephemeral if non_ephemeral else [lp.port for lp in self.ports]
        seen: set[int] = set()
        result: list[int] = []
        for p in ordered:
            if p not in seen:
                seen.add(p)
                result.append(p)
        return result


def run_capture(cmd: list[str]) -> str:
    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    return proc.stdout or ""


def parse_etime(etime: str) -> int:
    days = 0
    rest = etime.strip()
    if "-" in rest:
        day_part, rest = rest.split("-", 1)
        days = int(day_part)
    parts = [int(x) for x in rest.split(":")]
    if len(parts) == 3:
        hours, mins, secs = parts
    elif len(parts) == 2:
        hours, mins, secs = 0, parts[0], parts[1]
    else:
        return 0
    return days * 86400 + hours * 3600 + mins * 60 + secs


def format_uptime(seconds: int) -> str:
    if seconds < 60:
        return f"{seconds}s"
    days, rem = divmod(seconds, 86400)
    hours, rem = divmod(rem, 3600)
    mins, _ = divmod(rem, 60)
    if days > 0:
        return f"{days}d {hours:02d}h"
    if hours > 0:
        return f"{hours}h {mins:02d}m"
    return f"{mins}m"


def parse_duration(spec: str) -> int:
    cleaned = spec.strip()
    if cleaned.isdigit():
        return int(cleaned)
    pos = 0
    total = 0
    units = {"s": 1, "m": 60, "h": 3600, "d": 86400}
    for match in DURATION_TOKEN_RE.finditer(cleaned):
        if match.start() != pos:
            raise ValueError(f"Invalid duration: {spec!r} (expected e.g. 30m, 4h, 1d, 2h30m)")
        pos = match.end()
        total += int(match.group(1)) * units[match.group(2).lower()]
    if pos != len(cleaned) or total <= 0:
        raise ValueError(f"Invalid duration: {spec!r} (expected e.g. 30m, 4h, 1d, 2h30m)")
    return total


def parse_top_mem_token(token: str) -> int | None:
    cleaned = token.strip().rstrip("+-")
    if not cleaned:
        return None
    multipliers = {
        "B": 1,
        "K": 1024,
        "M": 1024**2,
        "G": 1024**3,
        "T": 1024**4,
    }
    unit = cleaned[-1].upper()
    if unit in multipliers:
        try:
            return int(float(cleaned[:-1]) * multipliers[unit])
        except ValueError:
            return None
    if cleaned.isdigit():
        return int(cleaned)
    return None


def format_bytes(num_bytes: int) -> str:
    if num_bytes >= 1024**3:
        return f"{num_bytes / (1024**3):.2f} GB"
    if num_bytes >= 1024**2:
        return f"{round(num_bytes / (1024**2))} MB"
    if num_bytes >= 1024:
        return f"{round(num_bytes / 1024)} KB"
    return f"{num_bytes} B"


def collect_top_memory() -> dict[int, int]:
    out = run_capture(["top", "-l", "1", "-stats", "pid,mem"])
    mem_by_pid: dict[int, int] = {}
    in_table = False
    for raw in out.splitlines():
        line = raw.strip()
        if not line:
            continue
        if not in_table:
            if line.startswith("PID"):
                in_table = True
            continue
        parts = line.split()
        if len(parts) < 2 or not parts[0].isdigit():
            continue
        parsed = parse_top_mem_token(parts[1])
        if parsed is not None:
            mem_by_pid[int(parts[0])] = parsed
    return mem_by_pid


def collect_processes(top_mem: dict[int, int]) -> dict[int, ProcInfo]:
    out = run_capture(["ps", "-axww", "-o", "pid=,ppid=,etime=,rss=,command="])
    procs: dict[int, ProcInfo] = {}
    for raw in out.splitlines():
        parts = raw.strip().split(None, 4)
        if len(parts) < 5:
            continue
        try:
            pid = int(parts[0])
            ppid = int(parts[1])
            rss_kb = int(parts[3])
        except ValueError:
            continue
        etime_raw = parts[2]
        command = parts[4].strip()
        first_token = command.split()[0] if command else ""
        exe_base = os.path.basename(first_token).lower()
        rss_bytes = rss_kb * 1024
        mem_bytes = top_mem.get(pid, rss_bytes)
        procs[pid] = ProcInfo(
            pid=pid,
            ppid=ppid,
            etime_raw=etime_raw,
            elapsed_secs=parse_etime(etime_raw),
            rss_bytes=rss_bytes,
            mem_bytes=mem_bytes,
            command=command,
            exe_base=exe_base,
        )
    return procs


def collect_listeners() -> dict[int, list[ListenPort]]:
    out = run_capture(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN", "-Fpcn"])
    listeners: dict[int, list[ListenPort]] = {}
    current_pid = 0
    seen: set[tuple[int, int, str]] = set()

    for raw in out.splitlines():
        if len(raw) < 2:
            continue
        tag, val = raw[0], raw[1:]
        if tag == "p" and val.isdigit():
            current_pid = int(val)
        elif tag == "n" and current_pid > 0:
            idx = val.rfind(":")
            if idx == -1 or idx == len(val) - 1:
                continue
            port_str = val[idx + 1 :]
            if not port_str.isdigit():
                continue
            port = int(port_str)
            host = val[:idx]
            key = (current_pid, port, host)
            if key in seen:
                continue
            seen.add(key)
            listeners.setdefault(current_pid, []).append(ListenPort(port=port, host=host, raw=val))

    for pid in listeners:
        listeners[pid].sort(key=lambda lp: (lp.is_ephemeral_loopback, lp.port))
    return listeners


def collect_cwds(pids: list[int]) -> dict[int, str]:
    if not pids:
        return {}
    pid_arg = ",".join(str(p) for p in sorted(set(pids)))
    out = run_capture(["lsof", "-a", "-p", pid_arg, "-d", "cwd", "-Fn"])
    cwds: dict[int, str] = {}
    current_pid = 0
    for raw in out.splitlines():
        if len(raw) < 2:
            continue
        if raw[0] == "p" and raw[1:].isdigit():
            current_pid = int(raw[1:])
        elif raw[0] == "n" and current_pid > 0:
            cwds[current_pid] = raw[1:]
    return cwds


def self_ancestor_pids(procs: dict[int, ProcInfo]) -> set[int]:
    protected: set[int] = set()
    cur = os.getpid()
    while cur > 1 and cur not in protected:
        protected.add(cur)
        info = procs.get(cur)
        if info is None:
            break
        cur = info.ppid
    return protected


def is_excluded(proc: ProcInfo, protected_pids: set[int]) -> bool:
    if proc.pid in protected_pids:
        return True
    if proc.exe_base in EXCLUDED_BINARIES:
        return True
    cmd = proc.command
    for needle in EXCLUDED_SUBSTRINGS:
        if needle in cmd:
            return True
    return False


def is_wrapper_process(proc: ProcInfo) -> bool:
    cmd = proc.command
    return bool(
        WT_TETHER_RE.search(cmd)
        or PACKAGE_DEV_WRAPPER_RE.search(cmd)
        or SHELL_WRAPPER_RE.search(cmd)
    )


def is_frontend_candidate(proc: ProcInfo, has_listen_port: bool) -> bool:
    cmd = proc.command
    if FRONTEND_CMD_RE.search(cmd):
        return True
    if PACKAGE_DEV_WRAPPER_RE.search(cmd):
        return True
    if proc.exe_base in ("node", "bun", "deno") and has_listen_port:
        if re.search(r"(?:^|[\s/])server\.(?:js|mjs|cjs|ts)\b", cmd):
            return True
    return False


def is_go_initial_candidate(proc: ProcInfo, has_listen_port: bool) -> bool:
    cmd = proc.command
    if proc.exe_base == "go" and re.search(r"^(?:\S+/)?go\s+run\b", cmd):
        return True
    if proc.exe_base == "air" and not cmd.startswith("/Applications/"):
        return True
    if not has_listen_port:
        return False
    if "/go-build" in cmd and "/exe/" in cmd:
        return True
    if "/tmp/GoLand/___" in cmd:
        return True
    if "onetrick" in cmd.lower():
        return True
    if "/.gemini/antigravity-acp/brain/" in cmd:
        return True
    return False


def is_user_project_cwd(cwd: str, home_dir: str) -> bool:
    if not cwd or not home_dir:
        return False
    prefixes = (
        os.path.join(home_dir, "Documents", "projects") + os.sep,
        os.path.join(home_dir, "WebstormProjects") + os.sep,
        os.path.join(home_dir, "GolandProjects") + os.sep,
        os.path.join(home_dir, ".air", "worktrees") + os.sep,
    )
    return cwd.startswith(prefixes)


def infer_project_dir(group_procs: list[ProcInfo], cwds: dict[int, str], home_dir: str) -> str:
    for p in group_procs:
        m = NODE_MODULES_DIR_RE.search(p.command)
        if m:
            return m.group(1)

    candidate_cwds = [cwds[p.pid] for p in group_procs if p.pid in cwds and cwds[p.pid] != "/"]
    if candidate_cwds:
        candidate_cwds.sort(key=lambda c: (is_user_project_cwd(c, home_dir), len(c)), reverse=True)
        return candidate_cwds[0]

    for p in group_procs:
        m = re.search(r"\bwt\s+.*?-C\s+([^\s]+)", p.command)
        if m:
            return m.group(1)
    return ""


def classify_scope(project_dir: str) -> tuple[str, bool]:
    if not project_dir:
        return ("orphan", False)
    exists = os.path.exists(project_dir)
    if not exists:
        return ("orphan", False)
    if f"{os.sep}.air{os.sep}worktrees{os.sep}" in project_dir:
        return ("temp-air", True)

    cur = Path(project_dir)
    for _ in range(5):
        dot_git = cur / ".git"
        if dot_git.is_file():
            return ("worktree", True)
        if dot_git.is_dir():
            return ("main", True)
        if cur.parent == cur:
            break
        cur = cur.parent
    return ("main", True)


def summarize_command(group_procs: list[ProcInfo]) -> str:
    for p in group_procs:
        cmd = p.command
        if "react-router dev" in cmd:
            return "react-router dev"
        if "next" in cmd and ("next dev" in cmd or "next-server" in cmd):
            return "next dev"
        if re.search(r"(?:^|[\s/])vite(?:\.js)?(?:\s|$)", cmd):
            return "vite"
        if "/tmp/GoLand/___" in cmd:
            return os.path.basename(cmd.split()[0])
        if re.search(r"^(?:\S+/)?go\s+run\b", cmd):
            return "go run"
    root = group_procs[0]
    return os.path.basename(root.command.split()[0]) if root.command else "server"


def shorten_home(path_str: str, home_dir: str) -> str:
    if not path_str:
        return "(unknown)"
    if home_dir and path_str == home_dir:
        return "~"
    if home_dir and path_str.startswith(home_dir + os.sep):
        return "~" + path_str[len(home_dir) :]
    return path_str


def discover_server_groups() -> list[ServerGroup]:
    home_dir = str(Path.home())
    top_mem = collect_top_memory()
    procs = collect_processes(top_mem)
    listeners = collect_listeners()
    protected_pids = self_ancestor_pids(procs)

    children_map: dict[int, list[int]] = {}
    for pid, proc in procs.items():
        children_map.setdefault(proc.ppid, []).append(pid)

    matched_kinds: dict[int, str] = {}
    maybe_go_listener_pids: list[int] = []

    for pid, proc in procs.items():
        if is_excluded(proc, protected_pids):
            continue
        has_port = pid in listeners
        if is_frontend_candidate(proc, has_port):
            matched_kinds[pid] = "frontend"
        elif is_go_initial_candidate(proc, has_port):
            matched_kinds[pid] = "go"
        elif has_port and proc.exe_base not in ("node", "bun", "deno", "python", "python3", "ruby", "ssh"):
            maybe_go_listener_pids.append(pid)

    cwd_lookup_pids = list(set(matched_kinds.keys()) | set(maybe_go_listener_pids))
    for pid in list(cwd_lookup_pids):
        cur = pid
        for _ in range(5):
            parent = procs.get(cur)
            if parent is None or parent.ppid <= 1:
                break
            cwd_lookup_pids.append(parent.ppid)
            cur = parent.ppid
    cwds = collect_cwds(cwd_lookup_pids)

    for pid in maybe_go_listener_pids:
        cwd = cwds.get(pid, "")
        if is_user_project_cwd(cwd, home_dir) and os.path.isfile(os.path.join(cwd, "go.mod")):
            matched_kinds[pid] = "go"

    for pid in list(matched_kinds.keys()):
        if matched_kinds[pid] == "go" and procs[pid].exe_base == "air":
            cwd = cwds.get(pid, "")
            if not (
                os.path.isfile(os.path.join(cwd, "go.mod"))
                or os.path.isfile(os.path.join(cwd, ".air.toml"))
            ):
                del matched_kinds[pid]

    def find_group_root(pid: int) -> int:
        root = pid
        cur = pid
        for _ in range(6):
            info = procs.get(cur)
            if info is None or info.ppid <= 1:
                break
            parent = procs.get(info.ppid)
            if parent is None or is_excluded(parent, protected_pids):
                break
            if parent.pid in matched_kinds or is_wrapper_process(parent):
                if SHELL_WRAPPER_RE.search(parent.command):
                    grand = procs.get(parent.ppid)
                    if grand is not None and (grand.pid in matched_kinds or is_wrapper_process(grand)):
                        root = grand.pid
                        cur = grand.pid
                        continue
                root = parent.pid
                cur = parent.pid
            else:
                break
        return root

    roots_to_seed_pids: dict[int, set[int]] = {}
    for pid in matched_kinds:
        root = find_group_root(pid)
        roots_to_seed_pids.setdefault(root, set()).add(pid)

    final_roots = set(roots_to_seed_pids.keys())
    merged_roots: dict[int, set[int]] = {}
    for root, seeds in roots_to_seed_pids.items():
        cur = root
        ancestor_root = root
        while cur > 1 and cur in procs:
            ppid = procs[cur].ppid
            if ppid in final_roots:
                ancestor_root = ppid
            cur = ppid
        merged_roots.setdefault(ancestor_root, set()).update(seeds)
        merged_roots[ancestor_root].add(root)

    groups: list[ServerGroup] = []
    all_group_pids_for_cwd: list[int] = []
    collected_trees: list[tuple[int, list[int], set[int]]] = []

    for root_pid, seeds in merged_roots.items():
        tree_pids: list[int] = []
        seen_tree: set[int] = set()
        stack = [root_pid]
        while stack:
            cur = stack.pop()
            if cur in seen_tree or cur not in procs:
                continue
            if is_excluded(procs[cur], protected_pids):
                continue
            seen_tree.add(cur)
            tree_pids.append(cur)
            for child in children_map.get(cur, []):
                stack.append(child)
        tree_pids.sort()
        all_group_pids_for_cwd.extend(p for p in tree_pids if p not in cwds)
        collected_trees.append((root_pid, tree_pids, seeds))

    if all_group_pids_for_cwd:
        cwds.update(collect_cwds(all_group_pids_for_cwd))

    for root_pid, tree_pids, seeds in collected_trees:
        group_procs = [procs[p] for p in tree_pids]
        has_frontend = any(matched_kinds.get(p) == "frontend" for p in tree_pids)
        has_go = any(matched_kinds.get(p) == "go" for p in tree_pids)
        kind = "frontend" if has_frontend or not has_go else "go"

        ports: list[ListenPort] = []
        for p in tree_pids:
            ports.extend(listeners.get(p, []))
        ports.sort(key=lambda lp: (lp.is_ephemeral_loopback, lp.port))

        # Skip pure npm/wt wrappers that never spawned a server or listener (e.g. exiting build script)
        if not ports and all(is_wrapper_process(procs[p]) for p in seeds):
            continue

        project_dir = infer_project_dir(group_procs, cwds, home_dir)
        scope, dir_exists = classify_scope(project_dir)
        total_mem = sum(gp.mem_bytes for gp in group_procs)
        uptime_secs = max(gp.elapsed_secs for gp in group_procs)

        groups.append(
            ServerGroup(
                root_pid=root_pid,
                pids=tree_pids,
                kind=kind,
                scope=scope,
                project_dir=project_dir,
                dir_exists=dir_exists,
                ports=ports,
                total_mem_bytes=total_mem,
                uptime_secs=uptime_secs,
                command_summary=summarize_command(group_procs),
            )
        )

    groups.sort(key=lambda g: (-g.total_mem_bytes, g.root_pid))
    return groups


def filter_groups(
    groups: list[ServerGroup],
    server_type: str,
    stale_only: bool,
    orphans_only: bool,
    older_than_secs: int | None,
) -> list[ServerGroup]:
    result: list[ServerGroup] = []
    for g in groups:
        if server_type != "all" and g.kind != server_type:
            continue
        if orphans_only and g.scope not in ("orphan", "temp-air"):
            continue
        if stale_only and not g.is_stale:
            continue
        if older_than_secs is not None and g.uptime_secs < older_than_secs:
            continue
        result.append(g)
    return result


def print_groups_table(groups: list[ServerGroup], home_dir: str) -> None:
    if not groups:
        print("No matching dev servers running.")
        return

    rows: list[list[str]] = []
    headers = ["#", "TYPE", "MEMORY", "PORTS", "UPTIME", "SCOPE", "SERVICE", "WORKTREE / PROJECT"]
    for idx, g in enumerate(groups, start=1):
        ports_list = g.primary_ports
        ports_str = ", ".join(str(p) for p in ports_list) if ports_list else "-"
        proj_str = shorten_home(g.project_dir, home_dir)
        if g.project_dir and not g.dir_exists:
            proj_str += " [deleted]"
        proc_Label = f"{g.command_summary} ({len(g.pids)}p)" if len(g.pids) > 1 else g.command_summary
        rows.append(
            [
                str(idx),
                g.kind,
                format_bytes(g.total_mem_bytes),
                ports_str,
                format_uptime(g.uptime_secs),
                g.scope,
                proc_Label,
                proj_str,
            ]
        )

    widths = [len(h) for h in headers]
    for r in rows:
        for i, cell in enumerate(r):
            widths[i] = max(widths[i], len(cell))

    def fmt_row(cells: list[str]) -> str:
        padded = [
            cells[i].rjust(widths[i]) if i in (0, 2, 4) else cells[i].ljust(widths[i])
            for i in range(len(cells))
        ]
        return "  ".join(padded).rstrip()

    print(fmt_row(headers))
    print("  ".join("-" * w for w in widths))
    for r in rows:
        print(fmt_row(r))

    total_mem = sum(g.total_mem_bytes for g in groups)
    total_procs = sum(len(g.pids) for g in groups)
    stale_mem = sum(g.total_mem_bytes for g in groups if g.is_stale)
    stale_count = sum(1 for g in groups if g.is_stale)
    summary = f"\nTotal: {len(groups)} server(s) ({total_procs} processes), ~{format_bytes(total_mem)}"
    if 0 < stale_count < len(groups):
        summary += f"  |  Stale/worktree: {stale_count} server(s), ~{format_bytes(stale_mem)}"
    print(summary)


def parse_selection(answer: str, groups: list[ServerGroup]) -> list[ServerGroup] | None:
    choice = answer.strip().lower()
    if choice in ("", "q", "quit", "n", "no"):
        return []
    if choice in ("a", "all", "y", "yes"):
        return list(groups)
    if choice in ("s", "stale"):
        return [g for g in groups if g.is_stale]

    selected_indices: set[int] = set()
    for part in choice.split(","):
        token = part.strip()
        if not token:
            continue
        if "-" in token:
            bounds = token.split("-", 1)
            if len(bounds) != 2 or not bounds[0].isdigit() or not bounds[1].isdigit():
                return None
            lo, hi = int(bounds[0]), int(bounds[1])
            if lo < 1 or hi > len(groups) or lo > hi:
                return None
            selected_indices.update(range(lo, hi + 1))
        elif token.isdigit():
            idx = int(token)
            if idx < 1 or idx > len(groups):
                return None
            selected_indices.add(idx)
        else:
            return None

    return [groups[i - 1] for i in sorted(selected_indices)]


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def stop_server_groups(groups: list[ServerGroup]) -> tuple[int, int]:
    target_pids: list[int] = []
    seen: set[int] = set()
    for g in groups:
        for pid in reversed(g.pids):
            if pid not in seen:
                seen.add(pid)
                target_pids.append(pid)

    for pid in target_pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass

    deadline = time.monotonic() + 2.0
    remaining = [pid for pid in target_pids if pid_alive(pid)]
    while remaining and time.monotonic() < deadline:
        time.sleep(0.1)
        remaining = [pid for pid in remaining if pid_alive(pid)]

    force_killed = 0
    for pid in remaining:
        try:
            os.kill(pid, signal.SIGKILL)
            force_killed += 1
        except ProcessLookupError:
            pass

    return len(target_pids), force_killed


def groups_to_json(groups: list[ServerGroup]) -> list[dict[str, object]]:
    return [
        {
            "rootPid": g.root_pid,
            "pids": g.pids,
            "type": g.kind,
            "scope": g.scope,
            "service": g.command_summary,
            "projectDir": g.project_dir,
            "dirExists": g.dir_exists,
            "ports": g.primary_ports,
            "memoryBytes": g.total_mem_bytes,
            "memoryHuman": format_bytes(g.total_mem_bytes),
            "uptimeSeconds": g.uptime_secs,
            "uptimeHuman": format_uptime(g.uptime_secs),
        }
        for g in groups
    ]


def build_arg_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="clean-servers",
        description="Inspect and clean up local frontend (Vite/React Router/Next/esbuild) and Go dev servers across git & Air worktrees.",
    )
    parser.add_argument(
        "-a",
        "--all",
        "-y",
        "--yes",
        dest="confirm_all",
        action="store_true",
        help="Stop all matching dev servers immediately without prompting",
    )
    parser.add_argument(
        "-s",
        "--stale",
        action="store_true",
        help="Only target non-main servers (linked git worktrees, ~/.air temp worktrees, and deleted/orphaned dirs)",
    )
    parser.add_argument(
        "--orphans",
        action="store_true",
        help="Only target servers in ~/.air/worktrees/temporary/* or deleted directories",
    )
    parser.add_argument(
        "--older-than",
        metavar="DURATION",
        help="Only target servers running longer than DURATION (e.g. 30m, 4h, 1d, 2h30m)",
    )
    type_group = parser.add_mutually_exclusive_group()
    type_group.add_argument(
        "--type",
        choices=("all", "frontend", "go"),
        default="all",
        help="Filter by server stack (default: all)",
    )
    type_group.add_argument(
        "--frontend",
        action="store_const",
        dest="type",
        const="frontend",
        help="Shorthand for --type frontend",
    )
    type_group.add_argument(
        "--go",
        action="store_const",
        dest="type",
        const="go",
        help="Shorthand for --type go",
    )
    parser.add_argument(
        "-l",
        "--list",
        "-n",
        "--dry-run",
        dest="list_only",
        action="store_true",
        help="List matching dev servers and memory footprint without stopping anything",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Output results as JSON",
    )
    return parser


def main() -> int:
    parser = build_arg_parser()
    args = parser.parse_args()

    older_than_secs: int | None = None
    if args.older_than:
        try:
            older_than_secs = parse_duration(args.older_than)
        except ValueError as exc:
            print(f"error: {exc}", file=sys.stderr)
            return 2

    all_groups = discover_server_groups()
    groups = filter_groups(
        all_groups,
        server_type=args.type,
        stale_only=args.stale,
        orphans_only=args.orphans,
        older_than_secs=older_than_secs,
    )

    home_dir = str(Path.home())

    if args.list_only:
        if args.json:
            print(json.dumps(groups_to_json(groups), indent=2))
        else:
            print_groups_table(groups, home_dir)
        return 0

    if not groups:
        if args.json:
            print(json.dumps({"stopped": [], "freedBytes": 0}, indent=2))
        else:
            print("No matching dev servers running.")
        return 0

    if args.confirm_all:
        to_stop = groups
    else:
        if args.json:
            print("error: --json without --list/--dry-run requires --yes/--all", file=sys.stderr)
            return 2
        print_groups_table(groups, home_dir)
        if not sys.stdin.isatty():
            print("\nNon-interactive stdin detected; pass --yes / --all to stop servers.", file=sys.stderr)
            return 1
        prompt = "\nStop which servers? [a]ll, [s]tale/non-main, numbers (e.g. 1,3-5), or [q]uit [q]: "
        while True:
            try:
                answer = input(prompt)
            except (EOFError, KeyboardInterrupt):
                print()
                return 0
            selected = parse_selection(answer, groups)
            if selected is not None:
                to_stop = selected
                break
            print("Invalid selection. Enter 'a', 's', row numbers like '1,2' or '1-3', or 'q'.")

    if not to_stop:
        print("Nothing stopped.")
        return 0

    freed_bytes = sum(g.total_mem_bytes for g in to_stop)
    stopped_procs, force_killed = stop_server_groups(to_stop)

    if args.json:
        print(
            json.dumps(
                {
                    "stopped": groups_to_json(to_stop),
                    "stoppedProcesses": stopped_procs,
                    "forceKilledProcesses": force_killed,
                    "freedBytes": freed_bytes,
                    "freedHuman": format_bytes(freed_bytes),
                },
                indent=2,
            )
        )
    else:
        extra = f" ({force_killed} SIGKILL)" if force_killed else ""
        print(
            f"Stopped {len(to_stop)} dev server(s) ({stopped_procs} processes{extra}), "
            f"freed ~{format_bytes(freed_bytes)}."
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
