Plug 'machakann/vim-highlightedyank'
Plug 'preservim/nerdtree'
Plug 'tpope/vim-commentary'
Plug 'mg979/vim-visual-multi'

source ~/.vimrc
"" -- Suggested options --
" Show a few lines of context around the cursor. Note that this makes the
" text scroll if you mouse-click near the start or end of the window.
set scrolloff=5
set notimeout
set surround
set ideajoin
set functiontextobj

" Needs to be installed by Plugin System
set which-key
" Needs to be install by Flash plugin
nmap s <Action>(flash.search)
xmap s <Action>(flash.search)

" enhance vim f (find for char in characters to the right of the current cursor)
nmap f <Action>(flash.find)
xmap f <Action>(flash.find)
" enhance vim F (find for char in characters to the left of the current cursor)
nmap F <Action>(flash.find_backward)
xmap F <Action>(flash.find_backward)
" enhance vim t (till for char in characters to the right of the current cursor)
nmap t <Action>(flash.till)
xmap t <Action>(flash.till)
" enhance vim T (till for char in characters to the left of the current cursor)
nmap T <Action>(flash.till_backward)
xmap T <Action>(flash.till_backward)
" enhance vim ; (Repeat the last f/F/t/T search)
nmap ; <Action>(flash.repeat)
xmap ; <Action>(flash.repeat)
" enhance vim , (Repeat the last f/F/t/T search backward)
nmap , <Action>(flash.repeat_backward)
xmap , <Action>(flash.repeat_backward)

set ideaeditor+=chat   " Vim keys in the AI chat input
set ideaeditor+=main   " ... and in plugin-provided editor tabs

let mapleader = ","

imap jk <Esc>

" <leader><leader> to activate, i.e. Press ",," then easymotion command
set easymotion

nmap <leader>ne :NERDTree<cr>
" See current file tree view
nmap <leader>nf <Action>(SelectInProjectView)

" Stop bad habits with arrow keys
nnoremap j gj
nnoremap k gk
" Window Adjustments

nmap <leader>maw <Action>(MergeAllWindowsAction)

"Toolbar Commands
nmap <leader>tt <Action>(ActivateTerminalToolWindow)
nmap <leader>th <Action>(HideActiveWindow)

" IDE implementation flows, glance view, implementation, then interface
nmap <leader>u <Action>(ShowHoverInfo)
nmap <leader>y <Action>(QuickImplementations)
nmap <leader>b <Action>(GotoImplementation)
nmap <leader>g <Action>(GotoSuperMethod)

" IDE refactor common cases
map <leader>rm <Action>(RefactoringMenu)
map <leader>re <Action>(RenameElement)
map <leader>rc <Action>(ReformatCode)
map <leader>ri <Action>(Inline)

map <leader>rfu <Action>(FindUsages)
map <leader>rff <Action>(FindUsagesInFile)


" Menu helpers
nmap <leader>e <Action>(ShowErrorDescription)
" IDE Tab Helpers
nmap <leader>cl <Action>(CloseAllToTheLeft)
nmap <leader>cr <Action>(CloseAllToTheRight)
nmap <leader>ca <Action>(CloseAllEditors)
nmap <leader>cu <Action>(CloseAllUnmodifiedEditors)
nmap <leader>rt <Action>(ReopenClosedTab)

" Relies on TabShifter plugin to be installed, Changes focus of cursor
nmap <C-h> <Action>(TabShiftActions.MoveFocusLeft)
nmap <C-j> <Action>(TabShiftActions.MoveFocusDown)
nmap <C-k> <Action>(TabShiftActions.MoveFocusUp)
nmap <C-l> <Action>(TabShiftActions.MoveFocusRight)

" Relies on TabShifter and splits screens in the direction
nmap <leader>h <Action>(TabShiftActions.ShiftLeft)
nmap <leader>j <Action>(TabShiftActions.ShiftDown)
nmap <leader>k <Action>(TabShiftActions.ShiftUp)
nmap <leader>l <Action>(TabShiftActions.ShiftRight)
